[model]
provider = "deepseek"            # "deepseek", "glm", "kimi", "minimax", or "ollama"
model_id = "deepseek-r4-flash"    # model to use by default
temperature = 0.3              # 0.0 - 1.0
max_tokens = 65536              # max response tokens (fallback)

# --- Provider: DeepSeek (OpenAI-compatible) ---
# API key / token for DeepSeek goes in ~/.config/mote/auth.json:
#   { "deepseek": { "api_key": "sk-..." } }
[providers.deepseek]
base_url = "https://api.deepseek.com"     # or "https://api.deepseek.com/v1"
default_model = "deepseek-v4-flash"       # fallback model for this provider
default_max_tokens = 65536                 # fallback max_tokens for this provider

# --- Provider: Ollama (local) ---
[providers.ollama]
base_url = "http://localhost:11434"
default_model = "deepseek-r1:8b"
default_max_tokens = 32000

# --- Provider: GLM / Z.ai (OpenAI-compatible) ---
# API key goes in ~/.config/mote/auth.json:
#   { "glm": { "api_key": "..." } }
[providers.glm]
base_url = "https://api.z.ai/api"
default_model = "glm-5.2"
default_max_tokens = 65536

# --- Provider: Kimi / Moonshot (OpenAI-compatible) ---
# API key goes in ~/.config/mote/auth.json:
#   { "kimi": { "api_key": "..." } }
[providers.kimi]
base_url = "https://api.moonshot.ai"
default_model = "kimi-k2.6"
default_max_tokens = 65536

# --- Provider: MiniMax (OpenAI-compatible) ---
# API key goes in ~/.config/mote/auth.json:
#   { "minimax": { "api_key": "..." } }
[providers.minimax]
base_url = "https://api.minimax.io"
default_model = "MiniMax-M3"
default_max_tokens = 65536

# --- Server bind ---
[server]
port = 9847                    # port to listen on (default: 9847)
default_agent = "build"        # agent used when no agent is specified

# --- UI accent colors ---
[ui]
input_accent = "cyan"          # left bar color for the input area
user_accent = "cyan"           # left bar color for user messages
# Assistant messages use blank indentation — no accent bar needed.
# Supported colors: cyan, green, blue, yellow, red, magenta, white

# --- History / session storage ---
[history]
dir = "history/"               # with ~/.config/mote/config.toml this resolves to ~/.config/mote/history/

[logging]
dir = "logs/"                  # with ~/.config/mote/config.toml this resolves to ~/.config/mote/logs/

# --- Audio transcription ---
# OpenAI API key goes in ~/.config/mote/auth.json:
#   { "openai": { "api_key": "sk-..." } }
[audio]
provider = "openai"
model = "gpt-4o-mini-transcribe"
sample_rate = 24000
channels = 1

# --- Prompt files ---
[prompts]
default = "prompts/system/mote.md"

# --- Optional: Google Sheets sync (read-only, service account) ---
# Syncs an activity/job spreadsheet tab into PM. Disabled by default.
# Requires:
#   1. A Google service-account JSON credential file (credentials_path),
#   2. The sheet shared with the service-account email as Viewer,
#   3. The read-only scope is hard-coded (spreadsheets.readonly).
# Import is MANUAL and explicit through the pm agent tools:
#   - pm_preview_google_sheet_site_jobs_import  (dry run, returns import_run_id + preview_hash)
#   - pm_apply_google_sheet_site_jobs_import     (applies only the reviewed preview; refuses if the sheet changed)
#   - pm_list_google_sheet_import_conflicts / pm_list_imported_google_sheet_jobs (inspect DB)
# A daily background scheduler is planned but not implemented yet.
# [google_sheets]
# enabled = true                                  # master switch (default: false)
# spreadsheet_id = "1lE3Mvs_mXsY-..."             # from the sheet URL
# sheet_name = "US"                               # tab name to read (default: US)
# credentials_path = "/absolute/path/to/service-account.json"
# eligible_activity_types = ["Boris Job", "Demo"] # exact activity types to import

# --- Optional: named agents with custom models/prompts ---
# [agents.plan]
# model = "ollama/qwen3.5:9b"
# model_specific = "prompts/plan.txt"
# temperature = 0.1
# max_tokens = 2048
# permissions = { read = "allow", write = "ask", edit = "ask", delete = "ask", bash = "deny" }

# --- Global permission defaults (applied to all agents unless overridden) ---
# [permissions]
# default = "ask"        # "allow" | "ask" | "deny"; omitted config defaults to "ask"
# read = "allow"         # recommended read-only tools
# glob = "allow"
# grep = "allow"
# write = "ask"          # mutating tools should usually ask
# edit = "ask"
# delete = "ask"
# bash = "ask"           # or "deny" for stricter workspaces

# --- Keybindings: see keybindings.toml.example ---
