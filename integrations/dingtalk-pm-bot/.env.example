# Copy this file to `.env` in the same folder:
#   integrations/dingtalk-pm-bot/.env

# --- Required DingTalk Stream credentials ---
# DingTalk app / bot client ID (aka app key)
DINGTALK_CLIENT_ID=your_dingtalk_client_id

# DingTalk app / bot client secret
DINGTALK_CLIENT_SECRET=your_dingtalk_client_secret

# --- Required local Mote PM bridge target ---
# Local Mote server base URL. The DingTalk bot sidecar will talk only to the
# PM interface exposed by mote.
MOTE_PM_BASE_URL=http://127.0.0.1:9847

# --- Optional local auth for the PM bridge ---
# Leave empty for now unless the future local PM bridge requires a token.
MOTE_PM_API_TOKEN=

# --- Optional runtime policy ---
# Restrict the bot to 1:1/private chat only.
PRIVATE_CHAT_ONLY=true

# Comma-separated DingTalk user IDs allowed to talk to the bot.
# Leave empty to allow any user who can reach the bot.
ALLOWED_USER_IDS=

# Prefix used when building mote runtime session keys.
# Example result: dingtalk:private:<user_id>:session:<conversation_id>
MOTE_SESSION_PREFIX=dingtalk

# Start a new DingTalk PM session after this many hours without user input.
MOTE_SESSION_INACTIVITY_HOURS=8

# Sidecar log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Timeout in seconds for local requests from the sidecar to mote.
MOTE_REQUEST_TIMEOUT_SECONDS=60

# Maximum number of stored history messages to send back to mote.
# Must remain an even number because history is stored as user/assistant pairs.
MOTE_MAX_HISTORY_MESSAGES=12

# Soft cap for total history characters sent to mote per request.
MOTE_MAX_HISTORY_CHARS=6000

# Maximum reply size sent back to DingTalk before truncation / summarization.
DINGTALK_MAX_REPLY_CHARS=4000
